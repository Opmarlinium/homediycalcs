---
// Fence Calculator — Laufmeter → Pfosten, Sektionen, Paneele
---

<div class="bg-white rounded-2xl border border-line p-8 max-w-2xl mx-auto shadow-sm">
  <h2 class="font-serif text-3xl text-ink mb-2">Fence Calculator</h2>
  <p class="text-ink-muted mb-8">
    Estimate posts, sections, and panels for a straight fence run.
  </p>

  <div class="space-y-6">
    <div class="flex items-center gap-2">
      <span class="text-sm text-ink-muted">Units:</span>
      <button id="funit-imperial" class="px-3 py-1 text-sm rounded-md border border-line-strong bg-white text-ink" data-unit="imperial">Feet</button>
      <button id="funit-metric" class="px-3 py-1 text-sm rounded-md border border-line text-ink-muted" data-unit="metric">Meters</button>
    </div>

    <div>
      <label for="flength" class="block text-sm font-medium text-ink mb-2">Total fence length (<span class="funit-label">ft</span>)</label>
      <input type="number" id="flength" value="100" min="0" step="0.1" class="w-full px-4 py-2 border border-line-strong rounded-lg focus:outline-none focus:border-ink text-ink" />
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="fspacing" class="block text-sm font-medium text-ink mb-2">Post spacing (<span class="funit-label">ft</span>)</label>
        <input type="number" id="fspacing" value="8" min="1" step="0.5" class="w-full px-4 py-2 border border-line-strong rounded-lg focus:outline-none focus:border-ink text-ink" />
        <p class="text-xs text-ink-muted mt-1">8 ft is standard for most wood fences.</p>
      </div>
      <div>
        <label for="fpanels" class="block text-sm font-medium text-ink mb-2">Panels per section</label>
        <input type="number" id="fpanels" value="1" min="1" max="6" class="w-full px-4 py-2 border border-line-strong rounded-lg focus:outline-none focus:border-ink text-ink" />
        <p class="text-xs text-ink-muted mt-1">Use 1 for pre-built panels, or 3 for individual rails.</p>
      </div>
    </div>

    <div>
      <label for="fgates" class="block text-sm font-medium text-ink mb-2">Number of gates</label>
      <input type="number" id="fgates" value="1" min="0" class="w-full px-4 py-2 border border-line-strong rounded-lg focus:outline-none focus:border-ink text-ink" />
    </div>
  </div>

  <div class="mt-8 pt-8 border-t border-line">
    <div class="bg-accent-soft rounded-xl p-6">
      <p class="text-sm text-ink-muted mb-2">You'll need</p>
      <p class="font-serif text-5xl text-ink mb-1">
        <span id="fresult-posts">0</span>
        <span class="text-2xl text-ink-muted">posts</span>
      </p>
      <p class="text-sm text-ink-muted" id="fresult-sub">Enter dimensions to calculate</p>
    </div>
  </div>
</div>

<script>
  const fLen = document.getElementById('flength') as HTMLInputElement;
  const fSpace = document.getElementById('fspacing') as HTMLInputElement;
  const fPanels = document.getElementById('fpanels') as HTMLInputElement;
  const fGates = document.getElementById('fgates') as HTMLInputElement;
  const fPosts = document.getElementById('fresult-posts');
  const fSub = document.getElementById('fresult-sub');
  const fImp = document.getElementById('funit-imperial');
  const fMet = document.getElementById('funit-metric');
  const fLabels = document.querySelectorAll('.funit-label');

  let fUnit: 'imperial' | 'metric' = 'imperial';

  function fCalc() {
    const length = parseFloat(fLen.value) || 0;
    const spacing = parseFloat(fSpace.value) || 1;
    const panelsPer = parseFloat(fPanels.value) || 1;
    const gates = parseFloat(fGates.value) || 0;

    // Sektionen = Länge / Pfostenabstand (aufrunden)
    const sections = Math.ceil(length / spacing);
    // Pfosten = Sektionen + 1 (gerader Verlauf), plus 1 extra pro Tor
    const posts = sections > 0 ? sections + 1 + gates : 0;
    const panels = sections * panelsPer;

    if (length > 0) {
      fPosts!.textContent = posts.toString();
      fSub!.textContent =
        `${sections} sections · ${panels} panel${panels !== 1 ? 's' : ''} · ${gates} gate${gates !== 1 ? 's' : ''}`;
    } else {
      fPosts!.textContent = '0';
      fSub!.textContent = 'Enter dimensions to calculate';
    }
  }

  function fSetUnit(u: 'imperial' | 'metric') {
    fUnit = u;
    const imp = u === 'imperial';
    fImp!.className = imp
      ? 'px-3 py-1 text-sm rounded-md border border-line-strong bg-white text-ink'
      : 'px-3 py-1 text-sm rounded-md border border-line text-ink-muted';
    fMet!.className = !imp
      ? 'px-3 py-1 text-sm rounded-md border border-line text-ink-muted'.replace('text-ink-muted','text-ink')
      : 'px-3 py-1 text-sm rounded-md border border-line text-ink-muted';
    fLabels.forEach((l) => { l.textContent = imp ? 'ft' : 'm'; });
    // Default-Pfostenabstand: 8 ft ≈ 2.4 m
    fSpace.value = imp ? '8' : '2.4';
    fCalc();
  }

  fImp?.addEventListener('click', () => fSetUnit('imperial'));
  fMet?.addEventListener('click', () => fSetUnit('metric'));
  [fLen, fSpace, fPanels, fGates].forEach((el) => {
    el?.addEventListener('input', fCalc);
    el?.addEventListener('change', fCalc);
  });
  fCalc();
</script>